# ============================================================================
# 1. INTEGRAÇÃO COM GOOGLE GEMINI (Obrigatório para IA: categorização, insights e chat)
# Obtenha sua chave em: https://aistudio.google.com/apikey
# (O modelo do agente é selecionado diretamente pelo Frontend com fallback automático)
# ============================================================================
GEMINI_API_KEY=cole_sua_chave_aqui

# ============================================================================
# 2. BANCO DE DADOS POSTGRESQL (Obrigatório)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# Caso rode via Docker Compose (docker compose up -d), o container do backend
# aponta automaticamente para o host interno `postgres`. Para rodar via `npm start`
# fora do container, mantenha `localhost`:
# ============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gastocerto

# ============================================================================
# 3. AUTENTICAÇÃO E SEGURANÇA (JWT)
# Chave secreta usada para assinar os tokens de login dos usuários
# ============================================================================
JWT_SECRET=troque_este_segredo_por_uma_chave_longa_e_segura
JWT_EXPIRES_IN_HOURS=168

# ============================================================================
# 4. SERVIDOR HTTP
# ============================================================================
PORT=3000

